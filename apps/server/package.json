    "@youly-en/env": "workspace:*",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "elysia": "^1.4.30",
    "zod": "catalog:",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@youly-en/config": "workspace:*",
    "tsdown": "^0.23.0",
    "typescript": "catalog:"
  }
}
