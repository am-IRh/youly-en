{
  "name": "@youly-en/auth",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "generate": "bunx @better-auth/cli generate --config src/index.ts --output ../db/src/schema/auth.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.22",
    "@youly-en/db": "workspace:*",
    "@youly-en/env": "workspace:*",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "zod": "catalog:",
    "@youly-en/utils": "workspace:*"
  },
  "devDependencies": {
    "@youly-en/config": "workspace:*",
    "typescript": "^6.0.3"
  }
}
